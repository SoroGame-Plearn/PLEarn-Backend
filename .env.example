# Environment
NODE_ENV=development
PORT=3000

# Database
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASS=postgres
DB_NAME=plearn

# JWT
JWT_SECRET=change_me_in_production
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=change_me_refresh_in_production
JWT_REFRESH_EXPIRES_IN=30d

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# Email (SendGrid)
SENDGRID_API_KEY=your_sendgrid_api_key_here
FROM_EMAIL=noreply@plearn.com
FROM_NAME=PLEarn Platform
FRONTEND_URL=http://localhost:3000

# Stellar / Soroban
STELLAR_NETWORK=testnet
STELLAR_HORIZON_URL=https://horizon-testnet.stellar.org
STELLAR_SOROBAN_RPC_URL=https://soroban-testnet.stellar.org
STELLAR_REWARD_CONTRACT_ID=
STELLAR_DISTRIBUTOR_SECRET=

# Storage (profile picture uploads)
# STORAGE_DRIVER=local writes to disk and works out of the box for dev/tests.
# Set STORAGE_DRIVER=s3 in production and configure the AWS_* vars below.
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=uploads
STORAGE_PUBLIC_BASE_URL=http://localhost:3000

# AWS_S3_ENDPOINT / AWS_S3_FORCE_PATH_STYLE are only needed for S3-compatible
# services (MinIO, DigitalOcean Spaces, etc). AWS_S3_PUBLIC_BASE_URL is
# optional and lets you serve avatars through a CDN/custom domain.
AWS_S3_BUCKET=
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_ENDPOINT=
AWS_S3_FORCE_PATH_STYLE=false
AWS_S3_PUBLIC_BASE_URL=
